@{
    ViewBag.Title = "Administrace";
}

Přítomno vzorků: @ViewBag.samplesCount <br />
Kultura: @ViewBag.culture <br />
Datum: @ViewBag.date <br />

<div class="row">
    <a asp-controller="Adm" asp-action="SpotOverView" asp-route-samples="false" class="btn btn-success">Spot overview</a>
    <a asp-controller="Adm" asp-action="HandUpdate" class="btn btn-success" style="margin: 10px;">Hand update</a>
    <a asp-controller="Adm" asp-action="GetStationOverView" asp-route-id="64" class="btn btn-success" style="margin: 10px;">Get Station OverView + id</a>
</div>
