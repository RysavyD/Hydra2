@{
    ViewBag.Title = "Administrace";
}

<dl class="dl-horizontal">
    <dt>Přítomno vzorků</dt>
    <dd>@ViewBag.samplesCount</dd>
    <dt>Kultura</dt>
    <dd>@ViewBag.culture</dd>
    <dt>Datum buildu</dt>
    <dd>@ViewBag.date</dd>
</dl>

<div class="row" style="margin-top: 1em;">
    <div class="col-md-6">
        <h4>Přehled</h4>
        <a asp-controller="Adm" asp-action="SpotOverView" asp-route-samples="false" class="btn btn-success">Spot overview</a>
        <a asp-controller="Adm" asp-action="SpotOverView" asp-route-samples="true" class="btn btn-secondary">Spot overview (s posledními vzorky)</a>
    </div>
</div>

<div class="row" style="margin-top: 1.5em;">
    <div class="col-md-6">
        <h4>Ruční stažení stanice</h4>
        <a asp-controller="Adm" asp-action="HandUpdate" class="btn btn-warning">Hand update</a>
    </div>
</div>

<div class="row" style="margin-top: 1.5em;">
    <div class="col-md-6">
        <h4>Náhled scrapu konkrétní stanice</h4>
        @* Action controller binds `id` from query string OR route, so the
           plain GET form submission lands on /Adm/GetStationOverView?id=N. *@
        <form class="form-inline" method="get"
              asp-controller="Adm" asp-action="GetStationOverView">
            <label for="stationLookupId" class="visually-hidden">ID stanice</label>
            <input type="number" id="stationLookupId" name="id" class="form-control"
                   placeholder="ID stanice" min="1" max="999" required style="margin-right: 10px;" />
            <button type="submit" class="btn btn-info">Zobrazit scrap</button>
        </form>
    </div>
</div>
