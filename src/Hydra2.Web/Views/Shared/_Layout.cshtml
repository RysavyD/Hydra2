<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#1a3d6e">
    <meta name="description" content="Hydra² — vodní stavy, průtoky a teploty českých řek a nádrží. Data od ČHMÚ, PVL, PLA, PMO a POH s historií od roku 2012.">
    <meta property="og:title" content="Hydra² — vodní stavy ČR" />
    <meta property="og:description" content="Vodní stavy, průtoky a teploty českých řek a nádrží. Historie od roku 2012." />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="cs_CZ" />

    @* Theme preference applied SYNC before body renders to avoid FOUC.
       Sets data-bs-theme="dark"|"light" on <html> based on localStorage or OS preference. *@
    <script src="~/js/theme-init.js" asp-append-version="true"></script>

    <link rel="manifest" href="~/manifest.webmanifest" />
    <link rel="icon" type="image/svg+xml" href="~/icons/icon.svg" />
    <link rel="apple-touch-icon" href="~/icons/icon.svg" />
    <link rel="shortcut icon" href="~/favicon.ico" />

    <title>Hydra2 @ViewBag.Title</title>
    <link rel="stylesheet" href="~/css/site.bundle.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-md navbar-dark fixed-top hydra-navbar">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">Hydra</a>
            <button type="button" class="navbar-toggler"
                    data-bs-toggle="collapse" data-bs-target="#navbarCollapse"
                    aria-controls="navbarCollapse" aria-expanded="false"
                    aria-label="Přepnout navigaci">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarCollapse">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Úvod</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Graf" asp-action="Index">Graf</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="About">O stránce</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Contact">Kontakt</a></li>
                </ul>
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <button type="button" id="theme-toggle" class="theme-toggle"
                                aria-label="Přepnout téma">Téma: auto</button>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
    <div class="container body-content">
        @RenderBody()
        <hr />
        <footer class="hydra-footer d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span class="text-body-secondary small">&copy; @DateTime.Now.Year Hydra²</span>
            <a href="https://github.com/RysavyD/Hydra2" target="_blank" rel="noopener"
               class="hydra-github-link small" aria-label="Hydra2 na GitHubu">
                <i class="bi bi-github" aria-hidden="true"></i> GitHub
            </a>
        </footer>
    </div>

    <script src="~/js/site.bundle.js" asp-append-version="true"></script>
    @await RenderSectionAsync("scripts", required: false)
</body>
</html>
