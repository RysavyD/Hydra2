@model Hydra2.Web.Models.GrafViewModel

@{
    ViewBag.Title = "Graf";
}

<link rel="stylesheet" href="~/lib/daterangepicker/daterangepicker.css" />

<div style="margin-top: 2em;" class="row">
    <div class="col-md-12">
        <h4>Údaje z většiny stanic jsou zaznamenávané od 29. 7. 2012. Pokud zvolíte starší datum, nebudou vrácena žádná data.</h4>
    </div>
</div>

<div style="margin-top: 2em;" class="row">
    <div class="col-md-3 col-sm-6 border">
        <label for="river"><h4>Tok</h4></label>
        @Html.DropDownList("river", Model.Rivers, new { @class = "form-control", aria_label = "Tok" })
    </div>
    <div class="col-md-3 col-sm-6 border">
        <label for="spot"><h4>Stanice</h4></label>
        <select id="spot" class="form-control" aria-label="Stanice"></select>
    </div>
    <div class="col-md-3 col-sm-6 rangeinput border">
        <label for="start"><h4>Začátek</h4></label>
        <input class="form-control" id="start" type="text" value="@Model.StartDate" aria-label="Datum začátku">
        <i class="glyphicon glyphicon-calendar fa fa-calendar" style="position: absolute; bottom: 20px; right: 24px; top:auto; cursor: pointer;" aria-hidden="true"></i>
    </div>
    <div class="col-md-3 col-sm-6 rangeinput border">
        <label for="stop"><h4>Konec</h4></label>
        <input class="form-control" id="stop" type="text" value="@Model.StopDate" aria-label="Datum konce">
        <i class="glyphicon glyphicon-calendar fa fa-calendar" style="position: absolute; bottom: 20px; right: 24px; top:auto; cursor: pointer;" aria-hidden="true"></i>
    </div>
</div>

<div style="margin-top: 2em;" class="row">
    <div class="col-md-6 border">
        <h4>Sledované veličiny</h4>
        <label class="checkbox-touch">
            <input type="checkbox" name="type" id="h" value="h" checked="checked" /> Hladina
        </label>
        <label class="checkbox-touch">
            <input type="checkbox" name="type" id="Q" value="Q" checked="checked" /> Průtok
        </label>
        <label class="checkbox-touch">
            <input type="checkbox" name="type" id="t" value="t" /> Teplota
        </label>
    </div>
    <div class="col-md-3 border">
        <div style="padding-top: 10px;">
            <button type="button" id="Reload" class="btn btn-success btn-lg">Načíst data</button>
        </div>
    </div>
</div>

<div style="margin-top: 2em; display: none;" class="row" id="riverInformation">
    <div class="col-md-12 table-responsive">
        <table style="width:100%">
            <tbody>
                <tr>
                    <th colspan="4">Limity pro stupně povodňové aktivity</th>
                </tr>
                <tr>
                    <th>1. stupeň</th>
                    <td><strong>H</strong> = <span id="river1"></span> [cm]</td>
                    <td style="width:20px;"><div style="background-color:#00FF00;" class="informBox"></div></td>
                    <td>1.SPA (bdělost)</td>
                </tr>
                <tr>
                    <th>2. stupeň</th>
                    <td><strong>H</strong> = <span id="river2"></span> [cm]</td>
                    <td style="width:20px;"><div style="background-color:#FFFF00;" class="informBox"></div></td>
                    <td>2.SPA (pohotovost)</td>
                </tr>
                <tr>
                    <th>3. stupeň</th>
                    <td><strong>H</strong> = <span id="river3"></span> [cm]</td>
                    <td style="width:20px;"><div style="background-color:#FF0000;" class="informBox"></div></td>
                    <td>3.SPA (ohrožení)</td>
                </tr>
                <tr>
                    <th>3. stupeň</th>
                    <td><strong>H</strong> = <span id="river3e"></span> [cm]</td>
                    <td style="width:20px;"><div style="background-color:#FF0000;" class="informBox"></div></td>
                    <td>3.SPA (extrémní povodeň)</td>
                </tr>
                <tr>
                    <th>Sucho</th>
                    <td><strong>H</strong> = <span id="river0"></span> [cm]</td>
                    <td style="width:20px;"><div style="background-color:#cceeff;" class="informBox"></div></td>
                    <td></td>
                </tr>
                <tr>
                    <th>Odkaz na měřící stanici</th>
                    <td colspan="4"><a href="#" target="_blank" rel="noopener" id="riverLink"></a></td>
                </tr>
                <tr>
                    <th>Odkaz na raft.cz s informacemi o toku</th>
                    <td colspan="4"><a href="#" target="_blank" rel="noopener" id="raftLink"></a></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<div style="margin-top: 2em; display: none;" class="row" id="reservoirInformation">
    <div class="col-md-12 table-responsive">
        <table class="tabulkaStaniceMereni">
            <tbody>
                <tr>
                    <td>Koruna hráze:</td>
                    <td><span id="korunaHrazeLbl"></span> [m n.m.]</td>
                </tr>
                <tr>
                    <td style="color: #ff8040;">Kóta přelivu:</td>
                    <td><span id="kotaPrelivuLbl"></span> [m n.m.]</td>
                </tr>
                <tr>
                    <td style="color: #ff0000;">Maximální retenční hladina:</td>
                    <td><span id="maxRetHladinaLbl"></span> [m n.m.]</td>
                </tr>
                <tr>
                    <td style="color: #008000;">Hladina zásobního prostoru:</td>
                    <td><span id="hladZasProstLbl"></span> [m n.m.]</td>
                </tr>
                <tr>
                    <td style="color: #ff00ff;">Hladina stálého nadržení:</td>
                    <td><span id="hladStalNadtLbl"></span> [m n.m.]</td>
                </tr>
                <tr>
                    <td>Odkaz na stanici</td>
                    <td><a href="#" target="_blank" rel="noopener" id="reservoirLink"></a></td>
                </tr>
                <tr>
                    <th>Odkaz na raft.cz</th>
                    <td><a href="#" target="_blank" rel="noopener" id="raftLink2"></a></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<div style="margin-top: 2em;" class="row">
    <div class="col-md-12">
        <div class="chart-container">
            <div id="chartdiv"></div>
            <div id="chartLoading" class="chart-skeleton is-hidden" role="status" aria-live="polite">Načítání dat…</div>
        </div>
    </div>
    <div class="col-md-12 table-responsive">
        <table id="dataTable" class="dataTable"></table>
    </div>
</div>

@section scripts {
    <script src="https://cdn.amcharts.com/lib/5/index.js" crossorigin="anonymous"></script>
    <script src="https://cdn.amcharts.com/lib/5/xy.js" crossorigin="anonymous"></script>
    <script src="https://cdn.amcharts.com/lib/5/themes/Animated.js" crossorigin="anonymous"></script>
    <script src="https://cdn.amcharts.com/lib/5/locales/cs_CZ.js" crossorigin="anonymous"></script>

    <script src="~/lib/daterangepicker/moment.min.js"></script>
    <script src="~/lib/daterangepicker/daterangepicker.js"></script>

    <style>
        #chartdiv { width: 100%; height: 100%; }
    </style>

    <script>
        // amCharts 5 root + chart - lifecycle objects.
        var root, chart, xAxis;

        function disposeChart() {
            if (root) {
                root.dispose();
                root = null;
                chart = null;
                xAxis = null;
            }
        }

        function CreateGraph(data) {
            // amCharts 5 requires explicit root per chart and full disposal on rebuild.
            disposeChart();

            root = am5.Root.new("chartdiv");
            root.setThemes([am5themes_Animated.new(root)]);
            if (typeof am5locales_cs_CZ !== "undefined") {
                root.locale = am5locales_cs_CZ;
            }

            chart = root.container.children.push(
                am5xy.XYChart.new(root, {
                    layout: root.verticalLayout,
                    panX: true,
                    panY: false,
                    wheelX: "panX",
                    wheelY: "zoomX",
                    pinchZoomX: true
                })
            );

            xAxis = chart.xAxes.push(
                am5xy.DateAxis.new(root, {
                    baseInterval: { timeUnit: "minute", count: 1 },
                    renderer: am5xy.AxisRendererX.new(root, { minGridDistance: 60 }),
                    tooltip: am5.Tooltip.new(root, {})
                })
            );
            xAxis.get("dateFormats")["day"] = "yyyy-MM-dd";
            xAxis.get("periodChangeDateFormats")["day"] = "yyyy-MM-dd";

            var chartData = generateChartData(data);

            createAxisAndSeries("h", "Hladina", false, "#009933", chartData);
            createAxisAndSeries("Q", "Průtok", true, "#0000cc", chartData);
            createAxisAndSeries("t", "Teplota", true, "#cc0000", chartData);

            chart.set("cursor", am5xy.XYCursor.new(root, {
                xAxis: xAxis,
                behavior: "zoomX"
            }));

            var legend = chart.children.push(am5.Legend.new(root, {
                centerX: am5.percent(50),
                x: am5.percent(50)
            }));
            legend.data.setAll(chart.series.values);

            chart.appear(800, 100);
        }

        function generateChartData(data) {
            var chartData = [];
            $.each(data, function (i, item) {
                chartData.push({
                    date: new Date(item.Date).getTime(),
                    h: item.h,
                    Q: item.Q,
                    t: item.t
                });
            });
            return chartData;
        }

        function createAxisAndSeries(field, name, opposite, color, chartData) {
            var yRenderer = am5xy.AxisRendererY.new(root, {
                opposite: opposite,
                stroke: am5.color(color),
                strokeOpacity: 1,
                strokeWidth: 2
            });
            yRenderer.grid.template.set("forceHidden", true);
            yRenderer.labels.template.set("fill", am5.color(color));

            var yAxis = chart.yAxes.push(
                am5xy.ValueAxis.new(root, { renderer: yRenderer })
            );

            var series = chart.series.push(
                am5xy.SmoothedXLineSeries.new(root, {
                    name: name,
                    xAxis: xAxis,
                    yAxis: yAxis,
                    valueXField: "date",
                    valueYField: field,
                    stroke: am5.color(color),
                    fill: am5.color(color),
                    tension: 0.8,
                    tooltip: am5.Tooltip.new(root, {
                        labelText: "{name}: [bold]{valueY}[/]"
                    })
                })
            );
            series.strokes.template.set("strokeWidth", 1);
            series.data.setAll(chartData);
            series.appear(500);
        }

        function showChartLoading() { $("#chartLoading").removeClass("is-hidden"); }
        function hideChartLoading() { $("#chartLoading").addClass("is-hidden"); }
    </script>
    <script>
        var riverId, spotId, start, stop, type;

        // ---- URL state -----------------------------------------------------
        // Primary: query string  ?riverId=2&spotId=5&start=01/04/2026&stop=08/04/2026&type=hQ
        // Fallback for legacy bookmarks: hash format  #2#5#01/04/2026#08/04/2026#hQ
        function readUrlState() {
            var p = new URLSearchParams(window.location.search);
            if (p.has("riverId") || p.has("spotId")) {
                return {
                    riverId: p.get("riverId"),
                    spotId: p.get("spotId"),
                    start: p.get("start"),
                    stop: p.get("stop"),
                    type: p.get("type"),
                };
            }
            // Legacy hash fallback
            var hashes = window.location.hash.split('#');
            return {
                riverId: hashes.length > 1 && $.isNumeric(hashes[1]) ? hashes[1] : null,
                spotId:  hashes.length > 2 ? hashes[2] : null,
                start:   hashes.length > 3 ? hashes[3] : null,
                stop:    hashes.length > 4 ? hashes[4] : null,
                type:    hashes.length > 5 ? hashes[5] : null,
            };
        }

        function writeUrlState() {
            if (!$.isNumeric(riverId) || !$.isNumeric(spotId)) return;
            var p = new URLSearchParams();
            p.set("riverId", riverId);
            p.set("spotId", spotId);
            if (start) p.set("start", start);
            if (stop) p.set("stop", stop);
            if (type) p.set("type", type);
            history.replaceState(null, "", "?" + p.toString());
        }

        // ---- Selection handlers --------------------------------------------
        $("#river").change(function() {
            riverId = $("#river").val();
            spotId = undefined;
            writeUrlState();

            $.ajax({
                type: "GET",
                url: '@Url.Content("~/Graf/GetSpots/")' + $("#river").val(),
                contentType: 'application/json; charset=utf-8',
                dataType: 'json',
                success: function(result) {
                    var sel = $("#spot");
                    sel.empty();
                    for (var i = 0; i < result.length; i++) {
                        sel.append('<option value="' + result[i].id + '">' + result[i].name + '</option>');
                    }
                    if (result.length === 1) {
                        spotId = result[0].id;
                        writeUrlState();
                    }
                },
                error: function(xhr) {
                    alert("Nastala chyba \n\n" + xhr.responseText);
                }
            });
        });

        $("#spot").change(function() {
            spotId = $("#spot").val();
            writeUrlState();
        });

        $('.rangeinput i').click(function() {
            $(this).parent().find('input').click();
        });

        var dateRangeOptions = {
            "showDropdowns": true,
            "autoApply": true,
            "locale": {
                "format": "DD/MM/YYYY",
                "separator": " - ",
                "applyLabel": "Apply",
                "cancelLabel": "Cancel",
                "fromLabel": "From",
                "toLabel": "To",
                "customRangeLabel": "Custom",
                "daysOfWeek": ["Ne","Po","Út","St","Čt","Pá","So"],
                "monthNames": ["Leden","Únor","Březen","Duben","Květen","Červen","Červenec","Srpen","Září","Říjen","Listopad","Prosinec"],
                "firstDay": 1
            },
            "singleDatePicker": true,
            "linkedCalendars": false,
            "autoUpdateInput": false,
            "buttonClasses": "btn btn-lg"
        };

        $('#start').daterangepicker(dateRangeOptions, function(s) {
            $('#start').val(s.format('DD/MM/YYYY'));
        });
        $('#start').on('apply.daterangepicker', function() {
            start = $('#start').val();
            writeUrlState();
        });

        $('#stop').daterangepicker(dateRangeOptions, function(s) {
            $('#stop').val(s.format('DD/MM/YYYY'));
        });
        $('#stop').on('apply.daterangepicker', function() {
            stop = $('#stop').val();
            writeUrlState();
        });

        $("input[type=checkbox]").change(function() {
            type = GetSampleTypes();
            writeUrlState();
        });

        $("#Reload").click(function() {
            var spot = $("#spot option:selected");
            if (spot.text() === '') { alert('Není vybrána žádná stanice!'); return; }
            if (type === '') { alert('Není vybrána žádná veličina!'); return; }

            showChartLoading();
            $.ajax({
                type: "GET",
                url: '@Url.Content("~/Graf/GetData/")',
                contentType: 'application/json; charset=utf-8',
                dataType: 'json',
                data: { spot: spot.val(), start: $("#start").val(), stop: $("#stop").val(), type: type },
                success: function(result) {
                    CreateGraph(result.samples);
                    ShowSpotInformation(result.spot);
                    GenerateDataTable(result.samples);
                    hideChartLoading();
                },
                error: function(xhr) {
                    hideChartLoading();
                    alert("Nastala chyba \n\n" + xhr.responseText);
                }
            });
        });

        function ShowSpotInformation(spot) {
            if (spot.type == 0) {
                $("#reservoirInformation").hide();
                $("#river0").text(spot.spa0 == null ? "" : spot.spa0);
                $("#river1").text(spot.spa1 == null ? "" : spot.spa1);
                $("#river2").text(spot.spa2 == null ? "" : spot.spa2);
                $("#river3").text(spot.spa3 == null ? "" : spot.spa3);
                $("#river3e").text(spot.spa3e == null ? "" : spot.spa3e);
                $("#riverLink").text(spot.link).attr("href", spot.link || "#");
                if (spot.raftLink) { $("#raftLink").text(spot.raftLink).attr("href", spot.raftLink).show(); }
                else { $("#raftLink").hide(); }
                $("#riverInformation").show();
            } else {
                $("#riverInformation").hide();
                $("#korunaHrazeLbl").text(spot.spa3e == null ? "" : spot.spa3e);
                $("#kotaPrelivuLbl").text(spot.spa1 == null ? "" : spot.spa1);
                $("#maxRetHladinaLbl").text(spot.spa3 == null ? "" : spot.spa3);
                $("#hladZasProstLbl").text(spot.spa2 == null ? "" : spot.spa2);
                $("#hladStalNadtLbl").text(spot.spa0 == null ? "" : spot.spa0);
                $("#reservoirLink").text(spot.link).attr("href", spot.link || "#");
                if (spot.raftLink) { $("#raftLink2").text(spot.raftLink).attr("href", spot.raftLink).show(); }
                else { $("#raftLink2").hide(); }
                $("#reservoirInformation").show();
            }
        }

        function GenerateDataTable(samples) {
            var trHTML = '<thead><tr><th>Datum</th><th>Hladina</th><th>Průtok</th><th>Teplota</th></tr></thead><tbody>';
            $.each(samples, function (i, item) {
                trHTML += '<tr><td>' + item.Date + '</td><td>' +
                    (item.h != null ? item.h : '') + '</td><td>' +
                    (item.Q != null ? item.Q : '') + '</td><td>' +
                    (item.t != null ? item.t : '') + '</td></tr>';
            });
            trHTML += '</tbody>';
            $("#dataTable").html(trHTML);
        }

        function GetSampleTypes() {
            var selectedTypes = '';
            $.each($("input[type=checkbox]:checked"), function () {
                selectedTypes += $(this).val();
            });
            return selectedTypes;
        }

        // ---- Initial load --------------------------------------------------
        $(document).ready(function() {
            var s = readUrlState();
            riverId = s.riverId || undefined;
            spotId  = s.spotId || undefined;
            start   = s.start || $("#start").val();
            stop    = s.stop || $("#stop").val();

            if (s.type) {
                type = s.type;
                $("#h").prop('checked', type.includes('h'));
                $("#Q").prop('checked', type.includes('Q'));
                $("#t").prop('checked', type.includes('t'));
            } else {
                type = GetSampleTypes();
            }

            if (spotId) {
                showChartLoading();
                $("#river").val(riverId);
                $("#start").val(start);
                $("#stop").val(stop);

                $.ajax({
                    type: "GET",
                    url: '@Url.Content("~/Graf/GetSpots/")' + riverId,
                    contentType: 'application/json; charset=utf-8',
                    dataType: 'json',
                    success: function(result) {
                        var sel = $("#spot");
                        sel.empty();
                        for (var i = 0; i < result.length; i++) {
                            sel.append('<option value="' + result[i].id + '">' + result[i].name + '</option>');
                        }
                        $("#spot").val(spotId);
                        $("#Reload").click();
                    },
                    error: function() { hideChartLoading(); }
                });
            }
        });
    </script>
}
